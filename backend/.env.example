# ── backend/.env ─────────────────────────────────────────────────────────────
# Copy this file to "backend/.env" and fill in the keys you want.
# setup.bat / setup.command does this copy for you automatically.

# ── THE ONE KEY YOU ACTUALLY NEED ─────────────────────────────────────────────
# Free TwelveData key powers price history → charts, signals, backtest.
# Get one free (30 sec, no card): https://twelvedata.com/pricing  (Basic / Free)
# Without it the stock charts/signals won't load — but the Options, FX,
# Crash History, Japan Watch, China Watch and news pages still work.
TWELVEDATA_API_KEY=

# ── Everything below is OPTIONAL ──────────────────────────────────────────────

# Local server port (leave as-is)
PORT=3001
FRONTEND_URL=http://localhost:5173

# AI trade summaries (optional). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Live present-day macro snapshot on the Crash History page (optional, free):
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web-push notifications (optional)
VAPID_SUBJECT=mailto:admin@stockapp.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
